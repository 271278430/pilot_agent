# Copy to .env and edit locally. Never commit secrets.
REPOPILOT_BASE_URL=https://api.z.ai/api/paas/v4
REPOPILOT_MODEL=replace-with-your-available-model
REPOPILOT_API_KEY=
REPOPILOT_TIMEOUT=60
# Context and total tokens are separate budgets.
REPOPILOT_CONTEXT_TOKENS=12000
REPOPILOT_MAX_TOKENS=60000
REPOPILOT_MAX_COST=5.0
# USD per million input/output tokens; set using your provider's pricing.
REPOPILOT_INPUT_PRICE=0
REPOPILOT_OUTPUT_PRICE=0
